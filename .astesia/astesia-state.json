  "decisions": [
    {
      "id": "DEC-001",
      "title": "Hybrid Library Model (Digital & Physical)",
      "rationale": "Mendukung e-book reading (PDF in-app) sekaligus sirkulasi fisik konvensional (rak, barcode, denda)."
    },
    {
      "id": "DEC-002",
      "title": "Standardized PDF E-Book with Dynamic Watermark",
      "rationale": "Format PDF dipilih karena stabilitas rendering di PWA mobile/desktop dan kemudahan proteksi hak cipta via canvas watermark."
    },
    {
      "id": "DEC-003",
      "title": "Local School Account Management",
      "rationale": "Import NISN/NIP via CSV tanpa dependensi eksternal SSO."
    },
    {
      "id": "DEC-004",
      "title": "Modern Academic Minimalist Theme",
      "rationale": "Palette ramah mata untuk sesi membaca panjang (Sepia/Dark mode) dan Bottom Navigation mobile-first."
    },
    {
      "id": "ADR-001",
      "title": "SQLite (better-sqlite3) & Drizzle ORM",
      "rationale": "Embedded single-file DB memudahkan backup sekolah dan memiliki latensi super rendah."
    },
    {
      "id": "ADR-002",
      "title": "In-App PDF Canvas Rendering with Dynamic Watermark",
      "rationale": "Menghindari pembajakan file e-book sekolah tanpa memerlukan lisensi DRM pihak ketiga yang mahal."
    },
    {
      "id": "ADR-003",
      "title": "PWA Service Worker + IndexedDB Offline Strategy",
      "rationale": "Menyediakan pembacaan luring pada perangkat iOS dan Android."
    }
  ],
