# ===================================================
# Pustaka Sekolah PWA - Environment Configuration
# ===================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Secret Key (Wajib minimal 32 karakter pada instalasi produksi)
JWT_SECRET=rahasia-pustaka-sekolah-production-key-2026-astesia

# Database & Storage Lokal (Default jika Turso/Supabase tidak diisi)
DATABASE_URL=./pustaka.db
UPLOADS_DIR=./uploads/ebooks

# Business Circulation Rules
STUDENT_LOAN_LIMIT=2
STUDENT_LOAN_DAYS=7
TEACHER_LOAN_LIMIT=5
TEACHER_LOAN_DAYS=14
DAILY_FINE_AMOUNT=1000

# ===================================================
# Cloud Deployment Settings (Vercel + Turso + Supabase)
# ===================================================
# 1. Turso Cloud SQLite (Dapatkan di https://turso.tech)
# TURSO_DATABASE_URL=libsql://pustaka-sekolah-yourusername.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQ...

# 2. Supabase Storage (Dapatkan di https://supabase.com)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# SUPABASE_BUCKET_COVERS=covers
# SUPABASE_BUCKET_EBOOKS=ebooks
