{
  "name": "pustaka-sekolah-pwa",
  "version": "1.0.0",
  "description": "Aplikasi Perpustakaan Digital & Sirkulasi Fisik Sekolah berbasis PWA Multi-Platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:public": "concurrently -n \"SERVER,CLIENT,TUNNEL\" -c \"blue,green,magenta\" \"npm run dev:server\" \"npm run dev:client\" \"npm run tunnel\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node --import tsx src/server/index.ts",
    "start:public": "concurrently -n \"SERVER,TUNNEL\" -c \"blue,magenta\" \"npm run start\" \"cloudflared tunnel --url http://localhost:3001\"",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:seed:turso": "node scripts/init-turso.mjs",
    "tunnel": "cloudflared tunnel --url http://localhost:5173"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.109.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "express": "^4.21.2",
    "framer-motion": "^13.4.0",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.16.0",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.5",
    "postcss": "^8.5.3",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.8"
  }
}
